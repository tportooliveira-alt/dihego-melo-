# Nginx da DM81: serve o site estático e encaminha /api para o backend.
# Copie para /etc/nginx/sites-available/dm81 e crie o link em sites-enabled.
# Depois rode: sudo certbot --nginx -d seudominio.com.br -d www.seudominio.com.br

server {
    listen 80;
    server_name seudominio.com.br www.seudominio.com.br;

    root /var/www/dm81;
    index index.html;

    client_max_body_size 8M;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 512;

    # Site estático
    location / {
        try_files $uri $uri/ =404;
    }

    # Imagens e vídeo do hero podem ficar em cache longo.
    location ~* \.(jpg|jpeg|png|webp|svg|mp4|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # API
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # O painel do funil expõe dados de leads: proteja antes de abrir na internet.
    # location /api/funil {
    #     auth_basic "DM81";
    #     auth_basic_user_file /etc/nginx/.htpasswd-dm81;
    #     proxy_pass http://127.0.0.1:8000;
    # }

    # Nunca sirva banco, .env, log ou código-fonte.
    location ~ \.(db|db-wal|db-shm|env|log|py)$ { deny all; }
    location /backend/ { deny all; }

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}

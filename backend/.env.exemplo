# Copie para .env na VPS e preencha. Nunca versione o .env.

# ── IA ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DM81_MODELO_IA=claude-opus-5
DM81_MAX_TOKENS_IA=1024

# ── WhatsApp (Evolution API) ─────────────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=dm81
# Segredo que o Evolution manda no header X-Webhook-Token. Sem ele o webhook fica aberto.
EVOLUTION_WEBHOOK_TOKEN=

# Responder sozinho no WhatsApp (0 = desligado). Ligue só depois de testar.
WHATSAPP_AUTO_REPLY=0
# Enquanto testa, responda apenas para os números abaixo.
WHATSAPP_MODO_TESTE=1
WHATSAPP_NUMEROS_TESTE=5511999999999
# Travas contra banimento do número da loja.
WHATSAPP_LIMITE_DIARIO=50
WHATSAPP_COOLDOWN_SEG=20

# ── Repasse do lead quente ───────────────────────────────────────────
# Número do dono que recebe o aviso (só dígitos, com DDI 55).
WHATSAPP_DONO=
DM81_NOTIFICAR_DONO=1

# ── Servidor ─────────────────────────────────────────────────────────
DM81_DB_PATH=/var/www/dm81/backend/data/dm81.db
DM81_CORS_ORIGINS=https://seudominio.com.br
